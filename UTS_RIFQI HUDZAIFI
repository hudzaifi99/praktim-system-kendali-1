Soal 10

K = 10;

num1 = [1 4];
den1 = [1 3 2];

num2 = [1];
den2 = [1 1];

G1 = tf(num1,den1);
G2 = tf(num2,den2);

% Menambahkan gain
G1_gain = K*G1;

% Feedback negatif
sys = feedback(G1_gain,G2)

% Menampilkan pole
pole(sys)

% Grafik pole-zero
pzmap(sys);
grid on;

title('Feedback dengan Gain K=10');

